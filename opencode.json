{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "subagent_depth": 2
  },
  "permission": {
    "bash": {
      "*": "ask",
      "bun *": "allow",
      "bun --version": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "mkdir *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "sh *": "allow"
    },
    "edit": {
      "*": "ask",
      "profiles/**/state/**": "allow"
    },
    "write": {
      "*": "ask",
      "profiles/**/state/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "skill": {
      "*": "allow"
    },
    "task": {
      "*": "allow",
      "posting-scorer": "allow"
    },
    "external_directory": {
      "*": "allow"
    }
  }
}
