{
  "name": "job-hunter",
  "version": "1.0.0",
  "private": true,
  "description": "OpenCode-native job finder: search job boards, score postings against your resume, report them with links and tailored CV suggestions.",
  "license": "MIT",
  "workspaces": [
    ".agents/skills/*/cli"
  ],
  "scripts": {
    "install-portals": "python3 tools/install_portal_clis.py",
    "check": "python3 tools/check_repo.py",
    "test": "bun run --filter='*-cli' test",
    "test-tools": "python3 -m unittest discover -s tools/tests -t .",
    "typecheck": "bun run --filter='*-cli' typecheck"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
